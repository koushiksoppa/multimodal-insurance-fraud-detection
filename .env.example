# Copy to .env and adjust. .env is git-ignored and must never be committed.

# --- storage layout -------------------------------------------------------
# All paths are resolved relative to the repository root unless absolute.
MIFD_DATA_DIR=data
MIFD_ARTIFACT_DIR=experiments/runs
MIFD_FIGURE_DIR=evaluation/figures

# --- database -------------------------------------------------------------
# SQLite by default so the project runs with no external services.
# A PostgreSQL URL of the form postgresql+psycopg://user:pass@host:5432/db
# also works; supply it through the environment, never by editing this file.
MIFD_DATABASE_URL=sqlite:///database/claims.db

# --- compute --------------------------------------------------------------
# auto | cpu | cuda. "auto" selects cuda only when a CUDA device is present.
MIFD_DEVICE=auto
# Threads for CPU inference/training. Leave blank to use the PyTorch default.
MIFD_NUM_THREADS=4

# --- model backbones ------------------------------------------------------
MIFD_TEXT_ENCODER=sentence-transformers/all-MiniLM-L6-v2
MIFD_VISION_ENCODER=resnet18

# --- reproducibility ------------------------------------------------------
MIFD_SEED=20260921

# --- api ------------------------------------------------------------------
MIFD_API_HOST=127.0.0.1
MIFD_API_PORT=8000
# Comma-separated list of allowed CORS origins. Empty disables CORS entirely.
MIFD_CORS_ORIGINS=

# --- huggingface ----------------------------------------------------------
# Optional. Only needed for gated repositories; the datasets used here are
# public. Never commit a real token.
# HF_TOKEN=
